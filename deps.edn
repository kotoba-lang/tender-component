{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        io.github.kotoba-lang/kototama
        {:git/url "https://github.com/kotoba-lang/kototama.git"
         :git/sha "cafa790d0c426a3aa3412e9eb33aeebe89738494"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps
         {io.github.cognitect-labs/test-runner
          {:git/tag "v0.5.1" :git/sha "dfb30dd"}
          io.github.kotoba-lang/compiler
          {:git/url "https://github.com/kotoba-lang/compiler.git"
           :git/sha "57237db2b17f98db2c1f34115cf8205cc7f4294e"}
          io.github.kotoba-lang/abi
          {:git/url "https://github.com/kotoba-lang/abi.git"
           :git/sha "6b2e5185ff98aa9cfec3f371a019e75b4c089aae"}
          io.github.kotoba-lang/io-multiformats
          {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
           :git/sha "310724803db65840f00d2d98d7887f2b6a512bd3"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
